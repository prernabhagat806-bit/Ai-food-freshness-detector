# Copy this file to ".env" and fill in your keys. Restart `npm run dev` after any change.

# ---- AI (required) ----
# Default setup uses Google Gemini (free key: https://aistudio.google.com/apikey)
AI_API_KEY=AQ.Ab8RN6KnYrLLKGhEzzA0OGbxOwWZcNGzwrEJAn7uTN1u5AgxLg
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-3.8-flash
# Optional speed-up for models that "think" before answering. Try: low. If the API returns an
# error about this field, leave it empty.
AI_REASONING_EFFORT=
# Optional backup model, used automatically if the main model stays busy or unavailable.
# Pick any other vision-capable model name from your provider's model list.
AI_FALLBACK_MODEL=

# ---- Second food-check API (optional, recommended) ----
# Google Cloud Vision "label detection". When set, a photo is treated as food only if
# BOTH Gemini and Google Vision agree. Create a key at https://console.cloud.google.com
# (enable "Cloud Vision API"; billing must be enabled, first 1000 images/month are free).
GOOGLE_VISION_API_KEY=

# ---- Accounts / login ----
# Optional: long random text used to sign login sessions. If empty, one is generated
# automatically and saved in data/.jwt-secret
JWT_SECRET=
# Set to true only when the site is served over https://
COOKIE_SECURE=false

# Port for the local API server (Vite proxies /api to this)
PORT=8787
